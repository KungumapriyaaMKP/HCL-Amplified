# Environment Variables Template for Vercel Deployment

# -----------------------------------------------------------------------------
# 1. Primary LLM Provider (Groq)
# -----------------------------------------------------------------------------
# Groq is used as the primary LLM provider in lib/llm.ts when GROQ_API_KEY is present.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# -----------------------------------------------------------------------------
# 2. Supabase Configuration (Authentication & SSR)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key

# -----------------------------------------------------------------------------
# 3. Database Connection (Postgres / Supabase Direct Connection)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.your-project-id:password@aws-0-region.pooler.supabase.com:6543/postgres
DIRECT_DATABASE_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# 4. Fallback LLM Provider (OpenRouter - Optional)
# -----------------------------------------------------------------------------
# Used if Groq API key is absent or encounters network issues.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
