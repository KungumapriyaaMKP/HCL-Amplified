# Copy to backend/.env and fill in. NEVER commit .env, never use NEXT_PUBLIC_*.

# LLM -- Gemini for structured JSON, Groq for fast streaming chat.
# Both have free tiers; the router falls back between them, then to fixtures.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Catalog. Coursera and Microsoft Learn need no key.
# YouTube free quota: 10,000 units/day; search.list costs 100 => ~100 searches.
YOUTUBE_API_KEY=

# Comma-separated. Add your Vercel domain before deploying.
ALLOWED_ORIGINS=http://localhost:3000
