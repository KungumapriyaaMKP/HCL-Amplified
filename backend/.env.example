# Pathfinder Backend Configuration Example
APP_NAME=Pathfinder
DEBUG=false

# LLM Providers (Gemini for structured output, Groq for chat)
GOOGLE_API_KEY=
GROQ_API_KEY=

# Catalog Providers (Coursera and MS Learn need no key)
YOUTUBE_API_KEY=

# Supabase Auth + Per-User Persistence
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-optional-if-using-jwks

# CORS
ALLOWED_ORIGINS=http://localhost:3000
